{
  "manifest_version": 3,
  "name": "switch-dress",
  "version": "0.1.0",
  "description": "Chrome Extension base infrastructure with React + TypeScript + Vite",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "notifications", "sidePanel"],
  "optional_permissions": ["tabs", "scripting"],
  "host_permissions": ["https://openrouter.ai/*", "<all_urls>"],
  "action": {
    "default_title": "switch-dress"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.tsx"]
    }
  ],
  "options_page": "options/index.html",
  "web_accessible_resources": [
    {
      "resources": ["gallery/index.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
